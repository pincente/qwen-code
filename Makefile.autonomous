# Makefile for Qwen Code Autonomous Agent

.PHONY: build run stop logs test test-oauth simulate customize clean help

# Default target
help:
	@echo "Qwen Code Autonomous Agent Makefile"
	@echo ""
	@echo "Usage:"
	@echo "  make build        Build the autonomous agent Docker image"
	@echo "  make run          Run the autonomous agent"
	@echo "  make stop         Stop the autonomous agent"
	@echo "  make logs         View the autonomous agent logs"
	@echo "  make test         Test the communication system"
	@echo "  make test-oauth   Test the OAuth communication system"
	@echo "  make simulate     Set up a simulation environment for testing"
	@echo "  make customize    Customize the operating instructions"
	@echo "  make clean        Remove the Docker image"
	@echo "  make help         Show this help message"
	@echo ""
	@echo "Before running, make sure to:"
	@echo "1. Set the REPO_URL environment variable"
	@echo "2. Set the GEMINI_API_KEY environment variable"
	@echo "3. (Optional) Set the TELEGRAM_BOT_TOKEN environment variable"

# Build the Docker image
build:
	docker build -f Dockerfile.autonomous -t qwen-code-autonomous .

# Run the autonomous agent
run:
	@if [ ! -f .env ]; then \
		echo "ERROR: .env file not found. Please create a .env file with your configuration."; \
		echo "See .env.example for an example configuration."; \
		exit 1; \
	fi
	@if ! grep -q "REPO_URL=" .env || [ -z "$(grep REPO_URL= .env | cut -d '=' -f 2)" ]; then \
		echo "ERROR: REPO_URL is not set in .env file"; \
		exit 1; \
	fi
	@if ! grep -q "GEMINI_API_KEY=" .env || [ -z "$(grep GEMINI_API_KEY= .env | cut -d '=' -f 2)" ]; then \
		if ! grep -q "QWEN_OAUTH_TOKEN=" .env || [ -z "$(grep QWEN_OAUTH_TOKEN= .env | cut -d '=' -f 2)" ]; then \
			echo "ERROR: Either GEMINI_API_KEY or QWEN_OAUTH_TOKEN must be set in .env file"; \
			exit 1; \
		fi \
	fi
	docker compose -f docker-compose.autonomous.yml up -d

# Stop the autonomous agent
stop:
	docker compose -f docker-compose.autonomous.yml down

# View logs
logs:
	docker compose -f docker-compose.autonomous.yml logs -f

# Test the communication system
test:
	docker compose -f docker-compose.autonomous.yml exec qwen-code-autonomous /home/node/test-autonomous-communication.sh

# Test the OAuth communication system
test-oauth:
	docker compose -f docker-compose.autonomous.yml exec qwen-code-autonomous /home/node/test-oauth-communication.sh

# Remove the Docker image
clean:
	docker rmi qwen-code-autonomous || true

# Set up a simulation environment for testing
simulate:
	/home/paul/qwen-code/scripts/simulate-agent.sh

# Customize the operating instructions
customize:
	./scripts/customize-instructions.sh

# Quick setup for development
dev-setup:
	@echo "Setting up development environment..."
	npm install node-telegram-bot-api
	@echo "Development environment setup complete."