# Example environment file for Qwen Code Autonomous Agent
# Copy this file to .env and update with your actual values

# Required - URL of the repository to clone
REPO_URL=https://github.com/your-username/your-repo.git

# Required - Either GEMINI_API_KEY or QWEN_OAUTH_TOKEN must be set
# Get your API key from https://qwen.ai
GEMINI_API_KEY=your-gemini-api-key-here

# Optional - Get OAuth token through the OAuth flow or use pre-configured token
# QWEN_OAUTH_TOKEN=your-oauth-token-here

# Optional - Telegram bot token for notifications
# Create a bot with BotFather on Telegram to get this token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Optional - Git user configuration
GIT_USER_NAME=Qwen Code Agent
GIT_USER_EMAIL=qwen-code-agent@example.com

# Sandbox configuration
GEMINI_SANDBOX=true